# ============================================================================
# BandoFit — configurazione di deploy (docker compose)
# Copia questo file in `.env` accanto a docker-compose.yml e compila i valori.
# Il file .env NON va mai committato.
# ============================================================================

# --- Porte pubblicate sull'host ---
FRONTEND_PORT=3001
BACKEND_PORT=3002
# 127.0.0.1 = raggiungibili solo dal reverse proxy locale (consigliato).
# Mettere 0.0.0.0 per esporre direttamente le porte all'esterno (solo test).
BIND_ADDRESS=127.0.0.1

# --- Supabase PRIMARIO (piattaforma) ---
PRIMARY_SUPABASE_URL=
PRIMARY_SUPABASE_SERVICE_ROLE_KEY=
# Solo se il progetto usa ancora il legacy JWT secret HS256 (di norma vuoto)
PRIMARY_SUPABASE_JWT_SECRET=

# --- Supabase SECONDARIO (catalogo bandi, sola lettura) ---
SECONDARY_SUPABASE_URL=
SECONDARY_SUPABASE_ANON_KEY=

# --- URL pubblici ---
# Origine da cui il browser carica il frontend (per CORS), es. https://bandofit.example.com
CORS_ORIGINS=https://bandofit.example.com
# Stesso dominio: usato per i redirect degli inviti famiglia e i link nelle email
FRONTEND_URL=https://bandofit.example.com

# --- Email ---
# Provider scelto automaticamente: SMTP se SMTP_HOST è valorizzato, altrimenti
# Resend se c'è la API key, altrimenti le email vengono solo loggate nel
# container backend.

# Opzione A: SMTP (es. casella OVH MX Plan: ssl0.ovh.net, 465 SSL o 587 STARTTLS)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
# Utente = indirizzo email completo della casella, es. noreply@tuodominio.it
SMTP_USER=
SMTP_PASSWORD=

# Opzione B: Resend (API HTTP)
RESEND_API_KEY=

# Mittente (con SMTP deve appartenere alla casella/dominio autorizzato)
EMAIL_FROM=BandoFit <noreply@tuodominio.it>

# --- openapi.it (dati aziendali certificati e verifica CF) ---
# Credenziali da console.openapi.com (sezione chiavi API). ATTENZIONE: le
# chiavi di sandbox e produzione sono DIVERSE e devono corrispondere a
# OPENAPI_ENV. Vuote = importazione dati disattivata (l'app funziona comunque).
# Le API "Company" e "Risk" vanno attivate una tantum dalla Libreria API.
# OGNI IMPORT COSTA CREDITO (IT-full ~0,30 € + IVA; Verifica CF ~0,05 € + IVA).
OPENAPI_EMAIL=
OPENAPI_API_KEY=
OPENAPI_ENV=production

# --- Anti-enumerazione degli endpoint auth (migration 0025) ---
# Quanti proxy fidati stanno davanti: Cloudflare + nginx = 2 (docs/deploy.md).
# L'IP del client è l'elemento a -TRUSTED_PROXY_HOPS di X-Forwarded-For: contare
# da destra è ciò che rende l'header non falsificabile.
# NON impostare FORWARDED_ALLOW_IPS=*: uvicorn prenderebbe il PRIMO elemento di
# X-Forwarded-For, cioè quello che il client può iniettare.
TRUSTED_PROXY_HOPS=2
# Segreto dell'HMAC dei bucket di rate limiting: a DB non finiscono mai IP o
# email in chiaro. OBBLIGATORIO in deploy: con ENV=production (che docker-compose
# imposta da sé) il backend si rifiuta di partire senza. Generarlo con
# `openssl rand -hex 32` e sceglierlo una volta sola: cambiarlo azzera i
# contatori in corso, perché i bucket derivano da lui.
RATE_LIMIT_PEPPER=

# --- AI-check (API Anthropic) ---
# Chiave da console.anthropic.com. Vuota = AI-check disattivato (l'app
# funziona comunque). OGNI REPORT COSTA CREDITO API (~0,10-0,20 $ a generazione).
ANTHROPIC_API_KEY=
AI_CHECK_MODEL=claude-sonnet-5

# --- Partenariati (docs/partenariati.md) ---
# Queste variabili arrivano al backend SOLO se docker-compose.yml le passa al
# container: aggiungerle lì è un'azione manuale (docs/deploy.md).
# Flag del modulo: false = rotte del modulo in 404 e nessuna voce nel frontend.
PARTENARIATI_ATTIVO=false
# Storico dei bilanci (IT-advanced nell'anteprima dell'import e in «Recupera i
# bilanci») e bilancio ufficiale, entrambi a pagamento: false = nessuna chiamata,
# rotte in 404 e nessuna voce nel frontend. Indipendente dal flag del modulo; si
# accende dopo la verifica in sandbox delle risposte reali (G1).
BILANCI_STORICO_ATTIVO=false
# Estrazione delle regole di partenariato: usa ANTHROPIC_API_KEY, costo a carico
# della piattaforma. Budget giornalieri fail-closed in CENTESIMI DI USD
# (500 = 5 $ al giorno per le estrazioni, 200 = 2 $ per gli altri servizi AI).
PARTENARIATO_AI_MODEL=claude-sonnet-5
PARTENARIATO_BUDGET_CENTS_GIORNO=500
PARTENARIATI_AI_BUDGET_CENTS_GIORNO_ALTRI=200
# Batch notturno delle estrazioni sui bandi aperti: 0 = spento. Se lo accendi,
# il budget consigliato è 300 (3 $ a notte).
PARTENARIATO_BATCH_BUDGET_CENTS_GIORNO=0
# Bozza AI del profilo partner (budget «altri»). Valori di default: togli il
# commento solo per cambiarli. Bozze al giorno per azienda e per titolare (su
# tutte le sue aziende), token di output, timeout della chiamata e minuti dopo
# i quali una bozza in corso è orfana.
# PARTNER_BOZZA_AI_LIMITE_GIORNO=3
# PARTNER_BOZZA_AI_LIMITE_UTENTE_GIORNO=10
# PARTNER_BOZZA_AI_MAX_TOKENS=4000
# PARTNER_BOZZA_AI_TIMEOUT_SECONDS=60
# PARTNER_BOZZA_AI_STALE_MINUTI=10
# Call di partenariato (budget «altri» per le proposte AI). Valori di default:
# togli il commento solo per cambiarli. Bozze aperte per azienda; proposte AI
# (posizioni e testi) al giorno per call e per titolare; token di output,
# timeout e minuti dopo i quali una proposta in corso è orfana; giorni della
# scadenza di default di una call; segnalazioni al giorno per utente.
# PARTNER_CALL_BOZZE_MAX=5
# PARTNER_CALL_AI_LIMITE_GIORNO=10
# PARTNER_CALL_AI_LIMITE_OWNER_GIORNO=30
# PARTNER_CALL_AI_MAX_TOKENS=6000
# PARTNER_CALL_AI_TIMEOUT_SECONDS=90
# PARTNER_CALL_AI_STALE_MINUTI=10
# PARTNER_CALL_SCADENZA_DEFAULT_GIORNI=60
# PARTNER_SEGNALAZIONI_LIMITE_GIORNO=10
# Matching delle call (WP6). Valori di default: togli il commento solo per
# cambiarli. Pesi del punteggio (somma 1) e penalità per ogni dato mancante
# (con un massimo); aziende suggerite per pagina; notifiche proattive alla
# pubblicazione (le prime K con almeno un requisito coperto e punteggio
# minimo, al massimo N a settimana per azienda); validità in secondi
# dell'indice in memoria; giorno (0 = lunedì) e ora del digest settimanale.
# PARTENARIATO_PESO_COPERTURA=0.50
# PARTENARIATO_PESO_AFFINITA=0.20
# PARTENARIATO_PESO_COMPLEMENTARITA=0.10
# PARTENARIATO_PESO_COMPLETEZZA=0.10
# PARTENARIATO_PESO_ROTAZIONE=0.10
# PARTENARIATO_PENALITA_DATO_MANCANTE=5
# PARTENARIATO_PENALITA_MAX=20
# PARTENARIATO_SUGGERITI_PAGINA=20
# PARTENARIATO_NOTIFICHE_TOP_K=20
# PARTENARIATO_NOTIFICHE_SOGLIA=50
# PARTENARIATO_NOTIFICHE_TETTO_SETTIMANA=3
# PARTENARIATO_INDICE_TTL_SECONDS=60
# PARTENARIATO_DIGEST_GIORNO=0
# PARTENARIATO_DIGEST_ORA=08:30
# Candidature, inviti e chat (WP7). Valori di default: togli il commento solo
# per cambiarli. Giorni di validità di un invito (1..90) e inviti in attesa per
# call; limiti anti-abuso per utente (candidature e inviti al giorno, messaggi
# all'ora: non sono la quota del piano, che conta il database).
# PARTNER_INVITO_TTL_GIORNI=14
# PARTNER_INVITI_MAX_PER_CALL=30
# PARTNER_CANDIDATURE_LIMITE_GIORNO=10
# PARTNER_INVITI_LIMITE_GIORNO=50
# PARTNER_MESSAGGI_LIMITE_ORA=120
# Bozze AI dei documenti del partenariato (WP10: lettera d'intenti, NDA, term
# sheet; budget «altri»). Valori di default: togli il commento solo per
# cambiarli. Il limite al mese lo decide il piano (AdminPiani, «Bozze di
# documenti al mese»); qui bozze al giorno per titolare (su tutte le sue
# aziende, anche con un piano illimitato), token di output, timeout della
# chiamata e minuti dopo i quali una bozza in preparazione è orfana.
# PARTNER_BOZZE_DOCUMENTO_LIMITE_OWNER_GIORNO=10
# PARTNER_BOZZE_DOCUMENTO_MAX_TOKENS=8000
# PARTNER_BOZZE_DOCUMENTO_TIMEOUT_SECONDS=150
# PARTNER_BOZZE_DOCUMENTO_STALE_MINUTI=10

# --- Pagamenti (Revolut Merchant API, migration 0026/0027) ---
# Chiave segreta del Merchant account. Vuota = modulo pagamenti spento (503).
# Sandbox e produzione sono account SEPARATI con chiavi diverse: REVOLUT_ENV
# deve corrispondere. Al go-live: REVOLUT_ENV=production con la chiave reale.
REVOLUT_SECRET_KEY=
REVOLUT_ENV=sandbox
# Signing secret (wsk_...) dalla registrazione del webhook via API (docs/deploy.md).
REVOLUT_WEBHOOK_SECRET=
PAYMENT_SCHEDULER_ATTIVO=true
PAYMENT_ORA_ESECUZIONE=06:00

# --- Rimappatura dei bandi fusi (migration 0043, docs/deploy.md) ---
# Sposta preferiti, eventi del calendario e call attive dai bandi fusi nel
# catalogo al loro bando principale. Queste variabili arrivano al backend SOLO
# se docker-compose.yml le passa al container: aggiungerle lì è un'azione
# manuale. spenta (default) | prova (conta e scrive nel log, nessuna modifica)
# | attiva. Prima di una modalità diversa da spenta va applicata la 0043.
RIMAPPATURA_FUSI_MODALITA=spenta
# Minuti fra due passi (minimo 5).
RIMAPPATURA_FUSI_INTERVALLO_MINUTI=60

# --- Frontend (variabili COTTE NEL BUNDLE al build: dopo averle cambiate
#     serve `docker compose up -d --build frontend`) ---
# Progetto Supabase PRIMARIO (solo autenticazione)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Come il BROWSER raggiunge il backend. Con il reverse proxy consigliato:
#   https://bandofit.example.com/api/v1
# Per una prova diretta senza proxy: http://IP-SERVER:3002/api/v1
VITE_API_BASE_URL=https://bandofit.example.com/api/v1
# Ambiente del widget di pagamento Revolut ('sandbox' o 'prod'): deve
# corrispondere a REVOLUT_ENV. Cotta nel bundle: rebuild del frontend se cambia.
VITE_REVOLUT_MODE=sandbox
