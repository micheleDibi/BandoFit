# === DB primario (piattaforma BandoFit) ===
# URL del progetto Supabase primario, es. https://xxxx.supabase.co
PRIMARY_SUPABASE_URL=
# Chiave service_role del primario (SEGRETA: solo backend, mai nel frontend)
PRIMARY_SUPABASE_SERVICE_ROLE_KEY=
# JWT secret legacy (opzionale: serve solo se il progetto usa ancora HS256)
PRIMARY_SUPABASE_JWT_SECRET=

# === DB secondario (catalogo bandi, sola lettura) ===
SECONDARY_SUPABASE_URL=
SECONDARY_SUPABASE_ANON_KEY=

# === App ===
# Origini CORS separate da virgola
CORS_ORIGINS=http://localhost:5173
# «production» pretende i segreti che altrimenti degraderebbero in silenzio
# (RATE_LIMIT_PEPPER): senza, il backend non parte. Lo imposta docker-compose.
ENV=development
# URL pubblico del frontend (redirect inviti famiglia, link nelle email)
FRONTEND_URL=http://localhost:5173

# === Email ===
# Provider scelto automaticamente: SMTP se SMTP_HOST è valorizzato,
# altrimenti Resend se c'è la API key, altrimenti solo log (sviluppo).

# --- Opzione A: SMTP (es. casella OVH) ---
# OVH MX Plan: host ssl0.ovh.net, porta 465 (SSL) o 587 (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
# Utente = indirizzo email completo della casella
SMTP_USER=
SMTP_PASSWORD=

# --- Opzione B: Resend (API HTTP) --- https://resend.com/api-keys
RESEND_API_KEY=

# Mittente delle email (con SMTP deve appartenere alla casella/dominio)
EMAIL_FROM=BandoFit <noreply@tuodominio.it>

# --- openapi.it (dati aziendali certificati e verifica CF) ---
# Credenziali da console.openapi.com (sezione chiavi API): le chiavi di
# sandbox e produzione sono DIVERSE e devono corrispondere a OPENAPI_ENV.
# Vuote = importazione disattivata. In sviluppo usare la sandbox (gratuita).
# Le API "Company" e "Risk" vanno attivate una tantum dalla Libreria API.
OPENAPI_EMAIL=
OPENAPI_API_KEY=
OPENAPI_ENV=sandbox

# --- Anti-enumerazione degli endpoint auth (migration 0025) ---
# Quanti proxy fidati stanno davanti: Cloudflare + nginx = 2 (docs/deploy.md).
# In sviluppo, senza proxy, mettere 0 per usare l'IP del peer; lasciando 2 l'IP
# resta ignoto e il limite per IP non si applica (innocuo in locale).
# NON impostare FORWARDED_ALLOW_IPS=*: renderebbe l'IP falsificabile dal client.
TRUSTED_PROXY_HOPS=2
# Segreto dell'HMAC con cui si costruiscono i bucket del rate limiting: a DB non
# finiscono mai IP o email in chiaro. Con ENV=production è OBBLIGATORIO e senza
# il backend non parte: generarlo con `openssl rand -hex 32`. Da scegliere una
# volta sola — cambiarlo azzera i contatori in corso.
RATE_LIMIT_PEPPER=

# --- Pagamenti (Revolut Merchant API) ---
# Chiave segreta del Merchant account (Revolut Business > APIs > Merchant API).
# Vuota = modulo pagamenti disattivato (le rotte rispondono 503).
# ATTENZIONE: sandbox e produzione hanno chiavi DIVERSE e la sandbox è un
# account separato (sandbox-business.revolut.com): la chiave deve
# corrispondere a REVOLUT_ENV. In sviluppo usare SEMPRE la sandbox.
REVOLUT_SECRET_KEY=
REVOLUT_ENV=sandbox
# Signing secret (wsk_...) restituito alla registrazione del webhook via API
# (docs/deploy.md). Senza, l'endpoint webhook risponde 503.
REVOLUT_WEBHOOK_SECRET=
# Scheduler dei pagamenti (rinnovi automatici, dunning, cambi differiti):
# parte solo se REVOLUT_SECRET_KEY è valorizzata. Ora locale (fuso ALERT_FUSO).
PAYMENT_SCHEDULER_ATTIVO=true
PAYMENT_ORA_ESECUZIONE=06:00

# --- AI-check (API Anthropic) ---
# Chiave da console.anthropic.com. Vuota = AI-check disattivato (503).
# Ogni report costa ~0,10-0,20 $ di API: in sviluppo lasciare vuota se non serve.
ANTHROPIC_API_KEY=
AI_CHECK_MODEL=claude-sonnet-5

# --- Partenariati (docs/partenariati.md) ---
# Flag del modulo: false = rotte del modulo in 404 e nessuna voce nel frontend.
PARTENARIATI_ATTIVO=false
# Scheduler del modulo (failsafe e batch delle estrazioni, ogni giorno alle
# 05:30 ora locale): parte solo con PARTENARIATI_ATTIVO=true.
PARTENARIATI_SCHEDULER_ATTIVO=true
# Estrazione delle regole di partenariato: usa ANTHROPIC_API_KEY e costa
# credito a ogni analisi (~0,10 $). Budget giornalieri fail-closed in CENTESIMI
# DI USD: estrazioni per bando e altri servizi AI del modulo.
PARTENARIATO_AI_MODEL=claude-sonnet-5
PARTENARIATO_BUDGET_CENTS_GIORNO=500
PARTENARIATI_AI_BUDGET_CENTS_GIORNO_ALTRI=200
# Batch notturno delle estrazioni: 0 = spento (consigliato in sviluppo).
PARTENARIATO_BATCH_BUDGET_CENTS_GIORNO=0
# Bozza AI del profilo partner (budget «altri»). Valori di default: togli il
# commento solo per cambiarli. Bozze al giorno per azienda e per titolare (su
# tutte le sue aziende), token di output, timeout della chiamata e minuti dopo
# i quali una bozza in corso è orfana.
# PARTNER_BOZZA_AI_LIMITE_GIORNO=3
# PARTNER_BOZZA_AI_LIMITE_UTENTE_GIORNO=10
# PARTNER_BOZZA_AI_MAX_TOKENS=4000
# PARTNER_BOZZA_AI_TIMEOUT_SECONDS=60
# PARTNER_BOZZA_AI_STALE_MINUTI=10
