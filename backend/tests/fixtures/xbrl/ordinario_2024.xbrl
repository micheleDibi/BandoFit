<?xml version="1.0" encoding="UTF-8"?>
<!-- Istanza XBRL SINTETICA scritta a mano per i test: società fittizia, valori inventati.
     Bilancio ordinario 2024 con comparativo 2023 (tassonomia itcc-ci 2018-11-04).
     Il rendiconto finanziario e la nota integrativa riusano gli stessi concept
     d'istante a inizio esercizio (2023-12-31 per il 2024, 2022-12-31 per il 2023). -->
<xbrli:xbrl xmlns:xbrli="http://www.xbrl.org/2003/instance"
            xmlns:link="http://www.xbrl.org/2003/linkbase"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            xmlns:iso4217="http://www.xbrl.org/2003/iso4217"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns:itcc-ci="http://www.infocamere.it/itnn/fr/itcc/ci/2018-11-04"
            xmlns:itcc-ci-ese="http://www.infocamere.it/itnn/fr/itcc/ci/ese/2018-11-04">
  <link:schemaRef xlink:type="simple" xlink:href="itcc-ci-ese-2018-11-04.xsd"/>

  <!-- Un fatto PRIMA della definizione del suo contesto: l'ordine è libero. -->
  <itcc-ci:TotaleAttivo contextRef="c1" unitRef="u_euro" decimals="0">2150000</itcc-ci:TotaleAttivo>

  <xbrli:context id="c1">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:instant>2024-12-31</xbrli:instant></xbrli:period>
  </xbrli:context>
  <xbrli:context id="c2">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:instant>2023-12-31</xbrli:instant></xbrli:period>
  </xbrli:context>
  <xbrli:context id="c3">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:instant>2022-12-31</xbrli:instant></xbrli:period>
  </xbrli:context>
  <xbrli:context id="d1">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:startDate>2024-01-01</xbrli:startDate><xbrli:endDate>2024-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:context id="d2">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:startDate>2023-01-01</xbrli:startDate><xbrli:endDate>2023-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>

  <!-- Anagrafica -->
  <itcc-ci:DatiAnagraficiDenominazione contextRef="c1">ALFA BETA FITTIZIA SRL</itcc-ci:DatiAnagraficiDenominazione>
  <itcc-ci:DatiAnagraficiCodiceFiscale contextRef="c1">09876543217</itcc-ci:DatiAnagraficiCodiceFiscale>
  <itcc-ci:DatiAnagraficiPartitaIva contextRef="c1">09876543217</itcc-ci:DatiAnagraficiPartitaIva>

  <!-- Stato patrimoniale 2024 (istante di fine esercizio) -->
  <itcc-ci:PatrimonioNettoCapitale contextRef="c1" unitRef="u_euro" decimals="0">100000</itcc-ci:PatrimonioNettoCapitale>
  <itcc-ci:PatrimonioNettoUtilePerditaEsercizio contextRef="c1" unitRef="u_euro" decimals="0">48000</itcc-ci:PatrimonioNettoUtilePerditaEsercizio>
  <itcc-ci:TotalePatrimonioNetto contextRef="c1" unitRef="u_euro" decimals="0">610000</itcc-ci:TotalePatrimonioNetto>
  <itcc-ci:TotaleDebiti contextRef="c1" unitRef="u_euro" decimals="0">1210000</itcc-ci:TotaleDebiti>
  <itcc-ci:TotaleDisponibilitaLiquide contextRef="c1" unitRef="u_euro" decimals="0">180000</itcc-ci:TotaleDisponibilitaLiquide>
  <itcc-ci:TotalePassivo contextRef="c1" unitRef="u_euro" decimals="0">2150000</itcc-ci:TotalePassivo>

  <!-- Stato patrimoniale 2023 (comparativo, istante di fine esercizio) -->
  <itcc-ci:PatrimonioNettoCapitale contextRef="c2" unitRef="u_euro" decimals="0">100000</itcc-ci:PatrimonioNettoCapitale>
  <itcc-ci:PatrimonioNettoUtilePerditaEsercizio contextRef="c2" unitRef="u_euro" decimals="0">35000</itcc-ci:PatrimonioNettoUtilePerditaEsercizio>
  <itcc-ci:TotalePatrimonioNetto contextRef="c2" unitRef="u_euro" decimals="0">562000</itcc-ci:TotalePatrimonioNetto>
  <itcc-ci:TotaleDebiti contextRef="c2" unitRef="u_euro" decimals="0">1150000</itcc-ci:TotaleDebiti>
  <itcc-ci:TotaleDisponibilitaLiquide contextRef="c2" unitRef="u_euro" decimals="0">150000</itcc-ci:TotaleDisponibilitaLiquide>
  <itcc-ci:TotaleAttivo contextRef="c2" unitRef="u_euro" decimals="0">1980000</itcc-ci:TotaleAttivo>
  <itcc-ci:TotalePassivo contextRef="c2" unitRef="u_euro" decimals="0">1980000</itcc-ci:TotalePassivo>

  <!-- Conto economico 2024 -->
  <itcc-ci:ValoreProduzioneRicaviVenditePrestazioni contextRef="d1" unitRef="u_euro" decimals="0">1250000</itcc-ci:ValoreProduzioneRicaviVenditePrestazioni>
  <itcc-ci:TotaleValoreProduzione contextRef="d1" unitRef="u_euro" decimals="0">1300000</itcc-ci:TotaleValoreProduzione>
  <itcc-ci:CostiProduzionePersonaleTotaleCostiPersonale contextRef="d1" unitRef="u_euro" decimals="0">420000</itcc-ci:CostiProduzionePersonaleTotaleCostiPersonale>
  <itcc-ci:DifferenzaValoreCostiProduzione contextRef="d1" unitRef="u_euro" decimals="0">85000</itcc-ci:DifferenzaValoreCostiProduzione>
  <itcc-ci:ProventiOneriFinanziariInteressiAltriOneriFinanziariTotaleInteressiAltriOneriFinanziari contextRef="d1" unitRef="u_euro" decimals="0">12500</itcc-ci:ProventiOneriFinanziariInteressiAltriOneriFinanziariTotaleInteressiAltriOneriFinanziari>
  <itcc-ci:UtilePerditaEsercizio contextRef="d1" unitRef="u_euro" decimals="0">48000</itcc-ci:UtilePerditaEsercizio>

  <!-- Conto economico 2023 -->
  <itcc-ci:ValoreProduzioneRicaviVenditePrestazioni contextRef="d2" unitRef="u_euro" decimals="0">1100000</itcc-ci:ValoreProduzioneRicaviVenditePrestazioni>
  <itcc-ci:TotaleValoreProduzione contextRef="d2" unitRef="u_euro" decimals="0">1150000</itcc-ci:TotaleValoreProduzione>
  <itcc-ci:CostiProduzionePersonaleTotaleCostiPersonale contextRef="d2" unitRef="u_euro" decimals="0">390000</itcc-ci:CostiProduzionePersonaleTotaleCostiPersonale>
  <itcc-ci:DifferenzaValoreCostiProduzione contextRef="d2" unitRef="u_euro" decimals="0">70000</itcc-ci:DifferenzaValoreCostiProduzione>
  <itcc-ci:ProventiOneriFinanziariInteressiAltriOneriFinanziariTotaleInteressiAltriOneriFinanziari contextRef="d2" unitRef="u_euro" decimals="0">14000</itcc-ci:ProventiOneriFinanziariInteressiAltriOneriFinanziariTotaleInteressiAltriOneriFinanziari>
  <itcc-ci:UtilePerditaEsercizio contextRef="d2" unitRef="u_euro" decimals="0">35000</itcc-ci:UtilePerditaEsercizio>

  <!-- Rendiconto finanziario: liquidità di inizio esercizio (istante del giorno prima).
       Per il 2024 coincide con la chiusura 2023; per il 2023 è il 2022-12-31. -->
  <itcc-ci:TotaleDisponibilitaLiquide contextRef="c3" unitRef="u_euro" decimals="0">120000</itcc-ci:TotaleDisponibilitaLiquide>

  <!-- Nota integrativa: movimenti del patrimonio netto e dei debiti, valori di inizio esercizio. -->
  <itcc-ci:TotalePatrimonioNetto contextRef="c3" unitRef="u_euro" decimals="0">527000</itcc-ci:TotalePatrimonioNetto>
  <itcc-ci:PatrimonioNettoCapitale contextRef="c3" unitRef="u_euro" decimals="0">90000</itcc-ci:PatrimonioNettoCapitale>
  <itcc-ci:TotaleDebiti contextRef="c3" unitRef="u_euro" decimals="0">1090000</itcc-ci:TotaleDebiti>
  <itcc-ci:TotaleAttivo contextRef="c3" unitRef="u_euro" decimals="0">1870000</itcc-ci:TotaleAttivo>

  <!-- Nota integrativa: numero medio dei dipendenti (decimalItemType, unità pure). -->
  <itcc-ci:TotaleDipendentiNumeroMedio contextRef="c1" unitRef="u_puro" decimals="INF">12</itcc-ci:TotaleDipendentiNumeroMedio>
  <itcc-ci:TotaleDipendentiNumeroMedio contextRef="c2" unitRef="u_puro" decimals="INF">11.5</itcc-ci:TotaleDipendentiNumeroMedio>

  <!-- Nota integrativa: tupla (debiti per area geografica), da NON raccogliere. -->
  <itcc-ci:DebitiAreaGeografica>
    <itcc-ci:DebitiAreaGeograficaArea contextRef="c1">Italia</itcc-ci:DebitiAreaGeograficaArea>
    <itcc-ci:TotaleDebiti contextRef="c1" unitRef="u_euro" decimals="0">999</itcc-ci:TotaleDebiti>
  </itcc-ci:DebitiAreaGeografica>

  <!-- textBlock della nota integrativa: testo HTML escapato, da scartare. -->
  <itcc-ci:CriteriValutazioneIntroduzione contextRef="d1">&lt;p&gt;Criteri di valutazione: TotaleAttivo 1 e TotaleDebiti 2.&lt;/p&gt;&lt;table&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</itcc-ci:CriteriValutazioneIntroduzione>

  <xbrli:unit id="u_euro"><xbrli:measure>iso4217:EUR</xbrli:measure></xbrli:unit>
  <xbrli:unit id="u_puro"><xbrli:measure>xbrli:pure</xbrli:measure></xbrli:unit>
</xbrli:xbrl>
