<?xml version="1.0" encoding="UTF-8"?>
<!-- Istanza XBRL SINTETICA scritta a mano per i test: società fittizia, valori inventati.
     La tassonomia PCI non usa dimensioni: un contesto con segment o scenario è
     anomalo e i suoi fatti si IGNORANO, anche se hanno lo stesso periodo. -->
<xbrli:xbrl xmlns:xbrli="http://www.xbrl.org/2003/instance"
            xmlns:link="http://www.xbrl.org/2003/linkbase"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            xmlns:iso4217="http://www.xbrl.org/2003/iso4217"
            xmlns:xbrldi="http://xbrl.org/2006/xbrldi"
            xmlns:finto="http://example.com/dimensioni-finte"
            xmlns:itcc-ci="http://www.infocamere.it/itnn/fr/itcc/ci/2018-11-04">
  <link:schemaRef xlink:type="simple" xlink:href="itcc-ci-ese-2018-11-04.xsd"/>

  <xbrli:context id="i2024">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:instant>2024-12-31</xbrli:instant></xbrli:period>
  </xbrli:context>
  <xbrli:context id="d2024">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:startDate>2024-01-01</xbrli:startDate><xbrli:endDate>2024-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:context id="d2024_seg">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier>
      <xbrli:segment><xbrldi:explicitMember dimension="finto:Area">finto:Estero</xbrldi:explicitMember></xbrli:segment>
    </xbrli:entity>
    <xbrli:period><xbrli:startDate>2024-01-01</xbrli:startDate><xbrli:endDate>2024-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:context id="i2024_scen">
    <xbrli:entity><xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier></xbrli:entity>
    <xbrli:period><xbrli:instant>2024-12-31</xbrli:instant></xbrli:period>
    <xbrli:scenario><finto:Previsione>si</finto:Previsione></xbrli:scenario>
  </xbrli:context>
  <!-- Durata usata SOLO da fatti con segment: non deve diventare un esercizio. -->
  <xbrli:context id="d2023_seg">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.infocamere.it">09876543217</xbrli:identifier>
      <xbrli:segment><xbrldi:explicitMember dimension="finto:Area">finto:Italia</xbrldi:explicitMember></xbrli:segment>
    </xbrli:entity>
    <xbrli:period><xbrli:startDate>2023-01-01</xbrli:startDate><xbrli:endDate>2023-12-31</xbrli:endDate></xbrli:period>
  </xbrli:context>
  <xbrli:unit id="eur"><xbrli:measure>iso4217:EUR</xbrli:measure></xbrli:unit>

  <itcc-ci:DatiAnagraficiCodiceFiscale contextRef="i2024">09876543217</itcc-ci:DatiAnagraficiCodiceFiscale>

  <itcc-ci:ValoreProduzioneRicaviVenditePrestazioni contextRef="d2024" unitRef="eur" decimals="0">500000</itcc-ci:ValoreProduzioneRicaviVenditePrestazioni>
  <itcc-ci:ValoreProduzioneRicaviVenditePrestazioni contextRef="d2024_seg" unitRef="eur" decimals="0">1</itcc-ci:ValoreProduzioneRicaviVenditePrestazioni>
  <itcc-ci:UtilePerditaEsercizio contextRef="d2024" unitRef="eur" decimals="0">21000</itcc-ci:UtilePerditaEsercizio>
  <itcc-ci:UtilePerditaEsercizio contextRef="d2023_seg" unitRef="eur" decimals="0">5</itcc-ci:UtilePerditaEsercizio>
  <itcc-ci:TotaleAttivo contextRef="i2024" unitRef="eur" decimals="0">640000</itcc-ci:TotaleAttivo>
  <itcc-ci:TotaleAttivo contextRef="i2024_scen" unitRef="eur" decimals="0">3</itcc-ci:TotaleAttivo>
  <itcc-ci:TotalePatrimonioNetto contextRef="i2024_scen" unitRef="eur" decimals="0">4</itcc-ci:TotalePatrimonioNetto>
</xbrli:xbrl>
